# [PLACEHOLDER] Public branding — safe to expose to the browser
NEXT_PUBLIC_SITE_URL=https://bloommodels.com
NEXT_PUBLIC_AGENCY_NAME=Bloom Models
NEXT_PUBLIC_AGENCY_EMAIL=contact@bloommodels.com
NEXT_PUBLIC_WHATSAPP_NUMBER=40700000000
NEXT_PUBLIC_TELEGRAM_HANDLE=bloommodels

# [PLACEHOLDER] Where new applications/contact messages are emailed
EMAIL_TO=you@example.com

# [PLACEHOLDER] Resend API key — https://resend.com/api-keys
# Leave unset in local dev; the app skips sending and just logs to /data/applications.json
RESEND_API_KEY=
